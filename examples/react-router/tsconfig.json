{
  "include": ["app", "*.ts", ".content-query/**/*.d.ts", ".react-router/types/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite-plus/client"],
    "rootDirs": [".", "./.react-router/types"]
  }
}
