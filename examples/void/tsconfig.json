{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "void/env", "vite-plus/client"],
    "jsx": "react-jsx"
  },
  "include": ["src", "pages", "middleware", "tests", "*.ts", ".content-query/**/*.d.ts"]
}
