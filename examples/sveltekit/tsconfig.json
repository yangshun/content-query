{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "src",
    "*.ts",
    ".content-query/**/*.d.ts",
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/types/**/$types.d.ts"
  ]
}
